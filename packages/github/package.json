{
  "name": "@anbiq/github",
  "version": "0.1.0",
  "description": "GitHub tracker and git host for Anbiq: jobs as issues, work as pull requests, authenticated as a GitHub App.",
  "license": "MIT",
  "author": "Diyar Faraj",
  "homepage": "https://github.com/diyarfaraj/anbiq/tree/main/packages/github#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diyarfaraj/anbiq.git",
    "directory": "packages/github"
  },
  "bugs": "https://github.com/diyarfaraj/anbiq/issues",
  "keywords": [
    "anbiq",
    "github",
    "github-app",
    "issues",
    "pull-requests"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anbiq/core": "workspace:*"
  },
  "devDependencies": {
    "@anbiq/testkit": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
