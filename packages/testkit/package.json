{
  "name": "@anbiq/testkit",
  "version": "0.1.0",
  "description": "In-memory fakes and conformance test suites for Anbiq adapters.",
  "license": "MIT",
  "author": "Diyar Faraj",
  "homepage": "https://github.com/diyarfaraj/anbiq/tree/main/packages/testkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diyarfaraj/anbiq.git",
    "directory": "packages/testkit"
  },
  "bugs": "https://github.com/diyarfaraj/anbiq/issues",
  "keywords": [
    "anbiq",
    "testing",
    "conformance",
    "fakes"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anbiq/core": "workspace:*"
  },
  "peerDependencies": {
    "vitest": ">=3"
  },
  "publishConfig": {
    "access": "public"
  }
}
