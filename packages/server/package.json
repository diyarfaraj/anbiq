{
  "name": "@anbiq/server",
  "version": "0.2.0",
  "description": "The Anbiq server: chat webhooks in, runner callbacks back, jobs kept in SQLite.",
  "license": "MIT",
  "author": "Diyar Faraj",
  "homepage": "https://github.com/diyarfaraj/anbiq/tree/main/packages/server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diyarfaraj/anbiq.git",
    "directory": "packages/server"
  },
  "bugs": "https://github.com/diyarfaraj/anbiq/issues",
  "keywords": [
    "anbiq",
    "server",
    "sqlite",
    "chatops"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "anbiq-server": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@anbiq/core": "workspace:*",
    "@anbiq/engine-claude-code": "workspace:*",
    "@anbiq/engine-opencode": "workspace:*",
    "@anbiq/github": "workspace:*",
    "@anbiq/runner-github-actions": "workspace:*",
    "@anbiq/tap-discord": "workspace:*",
    "@anbiq/tap-slack": "workspace:*",
    "@anbiq/tap-teams": "workspace:*",
    "@anbiq/tap-telegram": "workspace:*",
    "@anbiq/tap-whatsapp-twilio": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anbiq/testkit": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
