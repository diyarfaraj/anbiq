{
  "name": "@anbiq/runner-github-actions",
  "version": "0.0.0",
  "description": "GitHub Actions runner for Anbiq: runs each crew as a workflow and reports back with a signed callback.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anbiq/core": "workspace:*",
    "@anbiq/github": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anbiq/testkit": "workspace:*",
    "yaml": "^2.9.1"
  }
}
