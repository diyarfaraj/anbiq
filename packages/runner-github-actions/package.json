{
  "name": "@anbiq/runner-github-actions",
  "version": "0.1.0",
  "description": "GitHub Actions runner for Anbiq: runs each crew as a workflow and reports back with a signed callback.",
  "license": "MIT",
  "author": "Diyar Faraj",
  "homepage": "https://github.com/diyarfaraj/anbiq/tree/main/packages/runner-github-actions#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diyarfaraj/anbiq.git",
    "directory": "packages/runner-github-actions"
  },
  "bugs": "https://github.com/diyarfaraj/anbiq/issues",
  "keywords": [
    "anbiq",
    "github-actions",
    "runner"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anbiq/core": "workspace:*",
    "@anbiq/github": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anbiq/testkit": "workspace:*",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
